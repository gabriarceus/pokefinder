# Set default behavior to automatically normalize line endings to LF on all platforms
* text=auto eol=lf

# Explicit text files
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.arb text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.plist text eol=lf
*.swift text eol=lf
*.kt text eol=lf
*.java text eol=lf

# Shell scripts must always use LF (macOS / Linux compatibility)
*.sh text eol=lf

# Windows batch files must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.ogg binary
*.wav binary
*.jar binary
*.aar binary
