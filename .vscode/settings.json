{
  "dart.flutterSdkPath": ".fvm/versions/3.41.0",
  "cSpell.language": "en,it-IT",
  "cSpell.words": [
    "pokefinder",
    "usecase",
    "usecases"
  ],
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.suggest.showWords": false,
    "editor.codeActionsOnSave": {
      "quickFix.add.required": "explicit",
      "quickFix.add.required.multi": "explicit",
      "quickFix.create.constructorForFinalFields": "explicit",
      "source.fixAll": "explicit"
    }
  }
}